{
  "name": "agent-in-notebook-vscode",
  "displayName": "Agent in Notebook",
  "description": "Chat with your ACP coding agent about a notebook (VS Code, Colab or Kaggle in Chrome), and run research experiments with OpenResearch.",
  "publisher": "jhinezeal123",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "vscode": "^1.105.0"
  },
  "main": "./dist/extension.cjs",
  "activationEvents": [
    "onFileSystem:ainb-chrome"
  ],
  "extensionKind": [
    "workspace"
  ],
  "categories": [
    "Notebooks"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/jhinezeal123/agent_in_notebook"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false
    }
  },
  "contributes": {
    "configuration": {
      "title": "Agent in Notebook",
      "properties": {
        "ainb.kaggle.chromePath": {
          "type": "string",
          "scope": "application",
          "default": "",
          "description": "Absolute path to the Google Chrome executable for Kaggle notebooks. Leave empty to detect Google Chrome automatically."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "ainb",
          "title": "Agent in Notebook",
          "icon": "notebook.svg"
        }
      ],
      "secondarySidebar": [
        {
          "id": "ainb-chat",
          "title": "Agent Chat",
          "icon": "notebook.svg"
        },
        {
          "id": "ainb-project",
          "title": "Research Project",
          "icon": "beaker.svg"
        }
      ]
    },
    "views": {
      "ainb": [
        {
          "type": "webview",
          "id": "ainb.research",
          "name": "Notebooks"
        }
      ],
      "ainb-chat": [
        {
          "type": "webview",
          "id": "ainb.chat",
          "name": "Agent Chat"
        }
      ],
      "ainb-project": [
        {
          "type": "webview",
          "id": "ainb.project",
          "name": "Project"
        },
        {
          "id": "ainb.code",
          "name": "Code"
        },
        {
          "id": "ainb.artifacts",
          "name": "Artifacts"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "ainb.code",
        "contents": "The current project's code shows here once OpenResearch is running.",
        "when": "ainb.code.state != none && ainb.code.state != ready"
      },
      {
        "view": "ainb.code",
        "contents": "No projects yet.\n[New Chat](command:ainb.newChat)",
        "when": "ainb.code.state == none"
      },
      {
        "view": "ainb.code",
        "contents": "The project's repository folder is empty.",
        "when": "ainb.code.state == ready && ainb.code.mode != changes"
      },
      {
        "view": "ainb.artifacts",
        "contents": "The current project's artifacts show here once OpenResearch is running.",
        "when": "ainb.artifacts.state != none && ainb.artifacts.state != ready"
      },
      {
        "view": "ainb.artifacts",
        "contents": "No projects yet.\n[New Chat](command:ainb.newChat)",
        "when": "ainb.artifacts.state == none"
      },
      {
        "view": "ainb.artifacts",
        "contents": "No artifacts yet. Files the research agent saves for this project show here.\n[New File](command:ainb.artifacts.newFile)",
        "when": "ainb.artifacts.state == ready"
      },
      {
        "view": "ainb.code",
        "contents": "Open a research chat of this project to see what its agent changed in its worktree.\n[Show Files](command:ainb.code.showFiles)",
        "when": "ainb.code.state == ready && ainb.code.mode == changes && ainb.code.changes == noChat"
      },
      {
        "view": "ainb.code",
        "contents": "This chat has no worktree yet: its agent makes one on its first turn.",
        "when": "ainb.code.state == ready && ainb.code.mode == changes && ainb.code.changes == pending"
      },
      {
        "view": "ainb.code",
        "contents": "No changes: the chat's worktree is as its branch started from the baseline.",
        "when": "ainb.code.state == ready && ainb.code.mode == changes && ainb.code.changes == clean"
      },
      {
        "view": "ainb.code",
        "contents": "Could not read this chat's changes.\n[Refresh](command:ainb.code.refresh)",
        "when": "ainb.code.state == ready && ainb.code.mode == changes && ainb.code.changes == error"
      }
    ],
    "commands": [
      {
        "command": "ainb.open",
        "title": "Open Agent Chat",
        "category": "Agent in Notebook",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "ainb.newChat",
        "title": "New Chat",
        "category": "Agent in Notebook",
        "icon": "$(add)"
      },
      {
        "command": "ainb.openSettings",
        "title": "Settings",
        "category": "Agent in Notebook",
        "icon": "$(gear)"
      },
      {
        "command": "ainb.openCompute",
        "title": "Compute",
        "category": "Agent in Notebook",
        "icon": "$(server)"
      },
      {
        "command": "ainb.chooseOrx",
        "title": "Choose the OpenResearch Program (orx)",
        "category": "Agent in Notebook"
      },
      {
        "command": "ainb.clearChat",
        "title": "Clear Chat",
        "category": "Agent in Notebook",
        "icon": "$(clear-all)"
      },
      {
        "command": "ainb.stopBridge",
        "title": "Stop the Bridge and Its Agents",
        "category": "Agent in Notebook",
        "icon": "$(debug-stop)"
      },
      {
        "command": "ainb.pickProject",
        "title": "Show Another Project",
        "category": "Agent in Notebook",
        "icon": "$(arrow-swap)"
      },
      {
        "command": "ainb.code.newFile",
        "title": "New File...",
        "category": "Project Code",
        "icon": "$(new-file)"
      },
      {
        "command": "ainb.code.newFolder",
        "title": "New Folder...",
        "category": "Project Code",
        "icon": "$(new-folder)"
      },
      {
        "command": "ainb.code.refresh",
        "title": "Refresh",
        "category": "Project Code",
        "icon": "$(refresh)"
      },
      {
        "command": "ainb.code.revealFolder",
        "title": "Reveal Repository Folder in File Explorer",
        "category": "Project Code",
        "icon": "$(folder-opened)"
      },
      {
        "command": "ainb.code.openToSide",
        "title": "Open to the Side",
        "category": "Project Code"
      },
      {
        "command": "ainb.code.revealInOS",
        "title": "Reveal in File Explorer",
        "category": "Project Code"
      },
      {
        "command": "ainb.code.openInTerminal",
        "title": "Open in Integrated Terminal",
        "category": "Project Code"
      },
      {
        "command": "ainb.code.copyPath",
        "title": "Copy Path",
        "category": "Project Code"
      },
      {
        "command": "ainb.code.copyRelativePath",
        "title": "Copy Relative Path",
        "category": "Project Code"
      },
      {
        "command": "ainb.code.rename",
        "title": "Rename...",
        "category": "Project Code"
      },
      {
        "command": "ainb.code.delete",
        "title": "Delete",
        "category": "Project Code"
      },
      {
        "command": "ainb.artifacts.newFile",
        "title": "New File...",
        "category": "Artifacts",
        "icon": "$(new-file)"
      },
      {
        "command": "ainb.artifacts.newFolder",
        "title": "New Folder...",
        "category": "Artifacts",
        "icon": "$(new-folder)"
      },
      {
        "command": "ainb.artifacts.refresh",
        "title": "Refresh",
        "category": "Artifacts",
        "icon": "$(refresh)"
      },
      {
        "command": "ainb.artifacts.revealFolder",
        "title": "Reveal Artifacts Folder in File Explorer",
        "category": "Artifacts",
        "icon": "$(folder-opened)"
      },
      {
        "command": "ainb.artifacts.openToSide",
        "title": "Open to the Side",
        "category": "Artifacts"
      },
      {
        "command": "ainb.artifacts.revealInOS",
        "title": "Reveal in File Explorer",
        "category": "Artifacts"
      },
      {
        "command": "ainb.artifacts.openInTerminal",
        "title": "Open in Integrated Terminal",
        "category": "Artifacts"
      },
      {
        "command": "ainb.artifacts.copyPath",
        "title": "Copy Path",
        "category": "Artifacts"
      },
      {
        "command": "ainb.artifacts.copyRelativePath",
        "title": "Copy Relative Path",
        "category": "Artifacts"
      },
      {
        "command": "ainb.artifacts.rename",
        "title": "Rename...",
        "category": "Artifacts"
      },
      {
        "command": "ainb.artifacts.delete",
        "title": "Delete",
        "category": "Artifacts"
      },
      {
        "command": "ainb.code.showChanges",
        "title": "Show Changes",
        "category": "Project Code",
        "icon": "$(git-compare)"
      },
      {
        "command": "ainb.code.showFiles",
        "title": "Show Files",
        "category": "Project Code",
        "icon": "$(list-tree)"
      },
      {
        "command": "ainb.code.openChange",
        "title": "Open Changes",
        "category": "Project Code",
        "icon": "$(git-compare)"
      },
      {
        "command": "ainb.code.openFile",
        "title": "Open File",
        "category": "Project Code",
        "icon": "$(go-to-file)"
      }
    ],
    "keybindings": [
      {
        "command": "ainb.code.rename",
        "key": "f2",
        "when": "focusedView == ainb.code && !inputFocus"
      },
      {
        "command": "ainb.code.delete",
        "key": "delete",
        "mac": "cmd+backspace",
        "when": "focusedView == ainb.code && !inputFocus"
      },
      {
        "command": "ainb.artifacts.rename",
        "key": "f2",
        "when": "focusedView == ainb.artifacts && !inputFocus"
      },
      {
        "command": "ainb.artifacts.delete",
        "key": "delete",
        "mac": "cmd+backspace",
        "when": "focusedView == ainb.artifacts && !inputFocus"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "ainb.newChat",
          "when": "view == ainb.research || view == ainb.chat",
          "group": "navigation@1"
        },
        {
          "command": "ainb.openCompute",
          "when": "view == ainb.research",
          "group": "navigation@2"
        },
        {
          "command": "ainb.openSettings",
          "when": "view == ainb.research || view == ainb.chat",
          "group": "navigation@3"
        },
        {
          "command": "ainb.open",
          "when": "view == ainb.research",
          "group": "navigation@0"
        },
        {
          "command": "ainb.clearChat",
          "when": "view == ainb.chat",
          "group": "navigation@3"
        },
        {
          "command": "ainb.stopBridge",
          "when": "view == ainb.chat || view == ainb.research",
          "group": "bridge@1"
        },
        {
          "command": "ainb.pickProject",
          "when": "view == ainb.project",
          "group": "navigation@1"
        },
        {
          "command": "ainb.code.newFile",
          "when": "view == ainb.code && ainb.code.state == ready && ainb.code.mode != changes",
          "group": "navigation@1"
        },
        {
          "command": "ainb.code.newFolder",
          "when": "view == ainb.code && ainb.code.state == ready && ainb.code.mode != changes",
          "group": "navigation@2"
        },
        {
          "command": "ainb.code.refresh",
          "when": "view == ainb.code",
          "group": "navigation@3"
        },
        {
          "command": "ainb.code.revealFolder",
          "when": "view == ainb.code && ainb.code.state == ready",
          "group": "more@1"
        },
        {
          "command": "ainb.artifacts.newFile",
          "when": "view == ainb.artifacts && ainb.artifacts.state == ready",
          "group": "navigation@1"
        },
        {
          "command": "ainb.artifacts.newFolder",
          "when": "view == ainb.artifacts && ainb.artifacts.state == ready",
          "group": "navigation@2"
        },
        {
          "command": "ainb.artifacts.refresh",
          "when": "view == ainb.artifacts",
          "group": "navigation@3"
        },
        {
          "command": "ainb.artifacts.revealFolder",
          "when": "view == ainb.artifacts && ainb.artifacts.state == ready",
          "group": "more@1"
        },
        {
          "command": "ainb.code.showChanges",
          "when": "view == ainb.code && ainb.code.state == ready && ainb.code.mode != changes",
          "group": "navigation@0"
        },
        {
          "command": "ainb.code.showFiles",
          "when": "view == ainb.code && ainb.code.mode == changes",
          "group": "navigation@0"
        }
      ],
      "view/item/context": [
        {
          "command": "ainb.code.openToSide",
          "when": "view == ainb.code && viewItem == projectFile",
          "group": "navigation@1"
        },
        {
          "command": "ainb.code.newFile",
          "when": "view == ainb.code && viewItem == projectFolder",
          "group": "1_new@1"
        },
        {
          "command": "ainb.code.newFolder",
          "when": "view == ainb.code && viewItem == projectFolder",
          "group": "1_new@2"
        },
        {
          "command": "ainb.code.revealInOS",
          "when": "view == ainb.code",
          "group": "2_reveal@1"
        },
        {
          "command": "ainb.code.openInTerminal",
          "when": "view == ainb.code",
          "group": "2_reveal@2"
        },
        {
          "command": "ainb.code.copyPath",
          "when": "view == ainb.code",
          "group": "6_copypath@1"
        },
        {
          "command": "ainb.code.copyRelativePath",
          "when": "view == ainb.code",
          "group": "6_copypath@2"
        },
        {
          "command": "ainb.code.rename",
          "when": "view == ainb.code && !listMultiSelection && viewItem =~ /^project/",
          "group": "7_modification@1"
        },
        {
          "command": "ainb.code.delete",
          "when": "view == ainb.code && viewItem =~ /^project/",
          "group": "7_modification@2"
        },
        {
          "command": "ainb.artifacts.openToSide",
          "when": "view == ainb.artifacts && viewItem == projectFile",
          "group": "navigation@1"
        },
        {
          "command": "ainb.artifacts.newFile",
          "when": "view == ainb.artifacts && viewItem == projectFolder",
          "group": "1_new@1"
        },
        {
          "command": "ainb.artifacts.newFolder",
          "when": "view == ainb.artifacts && viewItem == projectFolder",
          "group": "1_new@2"
        },
        {
          "command": "ainb.artifacts.revealInOS",
          "when": "view == ainb.artifacts",
          "group": "2_reveal@1"
        },
        {
          "command": "ainb.artifacts.openInTerminal",
          "when": "view == ainb.artifacts",
          "group": "2_reveal@2"
        },
        {
          "command": "ainb.artifacts.copyPath",
          "when": "view == ainb.artifacts",
          "group": "6_copypath@1"
        },
        {
          "command": "ainb.artifacts.copyRelativePath",
          "when": "view == ainb.artifacts",
          "group": "6_copypath@2"
        },
        {
          "command": "ainb.artifacts.rename",
          "when": "view == ainb.artifacts && !listMultiSelection",
          "group": "7_modification@1"
        },
        {
          "command": "ainb.artifacts.delete",
          "when": "view == ainb.artifacts",
          "group": "7_modification@2"
        },
        {
          "command": "ainb.code.openFile",
          "when": "view == ainb.code && viewItem == change",
          "group": "inline"
        },
        {
          "command": "ainb.code.openFile",
          "when": "view == ainb.code && viewItem == change",
          "group": "navigation@0"
        },
        {
          "command": "ainb.code.openChange",
          "when": "view == ainb.code && viewItem =~ /^change/",
          "group": "navigation@1"
        }
      ],
      "commandPalette": [
        {
          "command": "ainb.code.openToSide",
          "when": "false"
        },
        {
          "command": "ainb.code.revealInOS",
          "when": "false"
        },
        {
          "command": "ainb.code.openInTerminal",
          "when": "false"
        },
        {
          "command": "ainb.code.copyPath",
          "when": "false"
        },
        {
          "command": "ainb.code.copyRelativePath",
          "when": "false"
        },
        {
          "command": "ainb.code.rename",
          "when": "false"
        },
        {
          "command": "ainb.code.delete",
          "when": "false"
        },
        {
          "command": "ainb.artifacts.openToSide",
          "when": "false"
        },
        {
          "command": "ainb.artifacts.revealInOS",
          "when": "false"
        },
        {
          "command": "ainb.artifacts.openInTerminal",
          "when": "false"
        },
        {
          "command": "ainb.artifacts.copyPath",
          "when": "false"
        },
        {
          "command": "ainb.artifacts.copyRelativePath",
          "when": "false"
        },
        {
          "command": "ainb.artifacts.rename",
          "when": "false"
        },
        {
          "command": "ainb.artifacts.delete",
          "when": "false"
        },
        {
          "command": "ainb.code.openChange",
          "when": "false"
        },
        {
          "command": "ainb.code.openFile",
          "when": "false"
        }
      ]
    },
    "notebooks": [
      {
        "type": "ainb-chrome-notebook",
        "displayName": "Notebook in Chrome (Colab / Kaggle)",
        "selector": [
          {
            "filenamePattern": "*.ainb"
          }
        ],
        "priority": "default"
      }
    ]
  },
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@ainb/protocol": "workspace:*",
    "preact": "10.27.2",
    "ws": "^8.22.2"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/vscode": "1.105.0",
    "@types/ws": "^8.18.2",
    "esbuild": "0.28.2",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
